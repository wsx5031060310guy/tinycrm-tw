generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Contact {
  id          String        @id @default(cuid())
  name        String
  phone       String?
  email       String?
  lineId      String?
  company     String?
  tags        String[]
  status      ContactStatus @default(LEAD)
  notes       String?
  source      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  interactions Interaction[]

  @@index([status])
  @@index([name])
}

model Interaction {
  id        String          @id @default(cuid())
  contactId String
  type      InteractionType
  channel   String?
  summary   String
  occurredAt DateTime       @default(now())
  contact   Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([occurredAt])
}

enum ContactStatus {
  LEAD
  QUALIFIED
  CUSTOMER
  CHURNED
}

enum InteractionType {
  CALL
  MESSAGE
  MEETING
  NOTE
  EMAIL
  LINE
}

model Order {
  id              String        @id @default(cuid())
  merchantTradeNo String        @unique
  planCode        String
  amount          Int
  currency        String        @default("TWD")
  provider        OrderProvider
  providerRef     String?
  status          OrderStatus   @default(PENDING)
  customerEmail   String?
  rawCallback     Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([planCode])
  @@index([createdAt])
}

model Subscription {
  id                     String             @id @default(cuid())
  customerEmail          String
  planCode               String
  provider               OrderProvider
  providerSubscriptionId String?            @unique
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd       DateTime?
  cancelAt               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([customerEmail])
  @@index([status])
}

enum OrderProvider {
  ECPAY
  STRIPE
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}
